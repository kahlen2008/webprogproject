rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything under users/{uid} (profile, favourites, meal plan, shopping list)
    // can only be read and written by that user.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Optional ratings: anyone can read, only the author can write their own.
    match /recipes/{recipeId}/ratings/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
