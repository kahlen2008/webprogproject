rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Everything under users/{uid} (profile, favourites, meal plan, shopping list,
    // rated-recipes list) can only be read and written by that user.
    match /users/{userId}/{document=**} {
      allow read, write: if signedInAs(userId);
    }

    // A review must look exactly like createRatingDoc in js/schema.js:
    // whole-number stars 1 to 5, a comment of at most 300 characters,
    // a display name of 1 to 60 characters, and a server timestamp.
    function isValidRating() {
      let data = request.resource.data;
      return data.keys().hasOnly(['stars', 'comment', 'displayName', 'createdAt'])
        && data.keys().hasAll(['stars', 'comment', 'displayName', 'createdAt'])
        && data.stars is int && data.stars >= 1 && data.stars <= 5
        && data.comment is string && data.comment.size() <= 300
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.createdAt == request.time;
    }

    // Ratings: anyone can read, only the author can write their own.
    match /recipes/{recipeId}/ratings/{uid} {
      allow read: if true;
      allow create, update: if signedInAs(uid) && isValidRating();
      allow delete: if signedInAs(uid);
    }

    // Lets deleteUserData search every review at once (a collection group query
    // on "ratings") to find all of a deleted user's reviews. Reviews are public
    // anyway. It also matches leftover users/{uid}/ratings/{recipeId} entries
    // from the old "recipes I reviewed" list, which only hold a recipe id that
    // the user's public review already shows. Read only: writes still follow
    // the rules above.
    match /{path=**}/ratings/{ratingId} {
      allow read: if true;
    }

    // Anything not matched above is denied by default.
  }
}
